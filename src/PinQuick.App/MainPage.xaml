<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PinQuick.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:PinQuick.App.Converters"
    xmlns:mdl="using:PinQuick.Core.Models"
    xmlns:svc="using:PinQuick.App.Services"
    xmlns:vm="using:PinQuick.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="PinCardTemplate" x:DataType="vm:PinItemViewModel">
            <Grid Width="200" Height="150"
                  Padding="14"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  RightTapped="PinCard_RightTapped">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <FontIcon Glyph="{x:Bind IconGlyph}"
                              FontSize="28"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              Visibility="{x:Bind HasIconSource, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <Image Source="{x:Bind IconSource, Mode=OneWay}"
                           Width="30"
                           Height="30"
                           Stretch="Uniform"
                           Visibility="{x:Bind HasIconSource, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Button Grid.Column="1"
                        Padding="4"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ToggleFavoriteCommand}"
                        ToolTipService.ToolTip="Favorilere ekle / çıkar">
                    <Grid>
                        <FontIcon Glyph="&#xE734;"
                                  FontSize="16"
                                  Opacity="0.6"
                                  Visibility="{x:Bind IsFavorite, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <FontIcon Glyph="&#xE735;"
                                  FontSize="16"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  Visibility="{x:Bind IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Spacing="2">
                    <TextBlock Text="{x:Bind Title}"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind TypeDisplay}"
                               Opacity="0.7"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FilterTemplate" x:DataType="vm:SidebarFilterItemViewModel">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CollectionTemplate" x:DataType="mdl:Collection">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewPinAccelerator_Invoked" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="ExportAccelerator_Invoked" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="ImportAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RefreshAccelerator_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="EditAccelerator_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid"
          RequestedTheme="{x:Bind ViewModel.RequestedTheme, Mode=OneWay}"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,10,16,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="PinQuick" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="by KTYSoft" FontSize="11" Opacity="0.6" />
            </StackPanel>

            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     Width="360"
                     Margin="16,0,0,0"
                     VerticalAlignment="Center"
                     PlaceholderText="{x:Bind svc:Strings.SearchPlaceholder}"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" Invoked="ClearSearch_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>

            <Button Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewPinButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="{x:Bind svc:Strings.HeadNewPin}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind svc:Strings.HeadSettingsTooltip}"
                    Click="SettingsButton_Click">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <Button Grid.Column="5"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind svc:Strings.HeadMenuTooltip}">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind svc:Strings.MenuExport}" Click="ExportMenuItem_Click" />
                        <MenuFlyoutItem Text="{x:Bind svc:Strings.MenuImport}" Click="ImportMenuItem_Click" />
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE8E8;" FontSize="14" />
            </Button>

            <Button Grid.Column="6"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind svc:Strings.HeadRefreshTooltip}"
                    Click="RefreshButton_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="CollectionsRow" Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind svc:Strings.SideCategories}"
                           Margin="16,12,16,4"
                           Opacity="0.6"
                           FontSize="12" />

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Filters}"
                          SelectedItem="{x:Bind ViewModel.SelectedFilterItem, Mode=TwoWay}"
                          ItemTemplate="{StaticResource FilterTemplate}"
                          SelectionMode="Single" />

                <Grid Grid.Row="2" Margin="16,12,16,4" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Padding="4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind svc:Strings.SideToggleCollectionsTooltip}"
                            Click="CollectionsToggleButton_Click">
                        <FontIcon x:Name="CollectionsChevron" Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind svc:Strings.SideCollections}"
                               Opacity="0.6"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Padding="6"
                            ToolTipService.ToolTip="{x:Bind svc:Strings.SideNewCollectionTooltip}"
                            Click="NewCollectionButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3"
                            Padding="6"
                            ToolTipService.ToolTip="{x:Bind svc:Strings.SideDeleteCollectionTooltip}"
                            Click="DeleteCollectionButton_Click">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView x:Name="CollectionsList"
                          Grid.Row="3"
                          ItemsSource="{x:Bind ViewModel.Collections}"
                          SelectedItem="{x:Bind ViewModel.SelectedCollection, Mode=TwoWay}"
                          ItemTemplate="{StaticResource CollectionTemplate}"
                          SelectionMode="Single"
                          Margin="0,0,0,8" />

                <Button Grid.Row="4"
                        Margin="16,12,16,12"
                        HorizontalAlignment="Stretch"
                        Click="AboutMenuItem_Click"
                        ToolTipService.ToolTip="{x:Bind svc:Strings.SideAboutTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                        <TextBlock Text="{x:Bind svc:Strings.SideAbout}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Pin grid -->
            <Grid Grid.Column="1" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusBar"
                           Grid.Row="0"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Margin="0,0,0,8"
                           Opacity="0.7"
                           IsHitTestVisible="False" />

                <GridView x:Name="PinGrid"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Pins}"
                          SelectedItem="{x:Bind ViewModel.SelectedPin, Mode=TwoWay}"
                          ItemTemplate="{StaticResource PinCardTemplate}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          CanDragItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          AllowDrop="True"
                          DragItemsCompleted="PinGrid_DragItemsCompleted"
                          ItemClick="PinGrid_ItemClick"
DoubleTapped="PinGrid_DoubleTapped"
                           ScrollViewer.IsVerticalScrollChainingEnabled="False"
                           ToolTipService.ToolTip="{x:Bind svc:Strings.GridReorderTooltip}" />

                <StackPanel x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="{x:Bind svc:Strings.EmptyNoPins}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind svc:Strings.EmptyDescription}"
                               Opacity="0.7"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360" />
                    <Button Content="{x:Bind svc:Strings.EmptyFirstPin}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NewPinButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Detail panel -->
            <Grid x:Name="DetailPanel"
                  Grid.Column="2"
                  Width="300"
                  Visibility="Collapsed"
                  Padding="16"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid Width="34" Height="34">
                                <FontIcon x:Name="DetailIcon" FontSize="26" />
                                <Image x:Name="DetailIconThumb"
                                       Width="32"
                                       Height="32"
                                       Stretch="Uniform"
                                       Visibility="Collapsed" />
                            </Grid>
                            <StackPanel>
                                <TextBlock x:Name="DetailTypeDisplay" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="DetailTarget"
                                   FontSize="12"
                                   Opacity="0.8"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />

                        <TextBlock x:Name="DetailDescription"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="DetailTags"
                                   FontSize="12"
                                   Opacity="0.7"
                                   Visibility="Collapsed" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{x:Bind svc:Strings.DetailOpen}" Click="LaunchButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Grid.Column="1" Content="{x:Bind svc:Strings.DetailFavorite}" Click="FavoriteButton_Click" />
                        </Grid>

                        <Button Content="{x:Bind svc:Strings.DetailRunAsAdmin}" Click="LaunchAdminButton_Click" />
                        <Button Content="{x:Bind svc:Strings.DetailOpenLocation}" Click="OpenLocationButton_Click" />
                        <Button Content="{x:Bind svc:Strings.DetailEdit}" Click="EditButton_Click" />
                        <Button Content="{x:Bind svc:Strings.DetailDelete}" Click="DeleteButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>