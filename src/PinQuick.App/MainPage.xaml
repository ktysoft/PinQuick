<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PinQuick.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:PinQuick.App.Converters"
    xmlns:mdl="using:PinQuick.Core.Models"
    xmlns:svc="using:PinQuick.App.Services"
    xmlns:vm="using:PinQuick.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />

        <DataTemplate x:Key="PinCardTemplate" x:DataType="vm:PinItemViewModel">
            <Grid Width="{x:Bind CardWidth}" Height="{x:Bind CardHeight}"
                  Padding="14"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  RightTapped="PinCard_RightTapped">
                <Grid.Transitions>
                    <TransitionCollection>
                        <ContentThemeTransition />
                    </TransitionCollection>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <FontIcon Glyph="{x:Bind IconGlyph}"
                              FontSize="28"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              Visibility="{x:Bind HasIconSource, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <Image Source="{x:Bind IconSource, Mode=OneWay}"
                           Width="30"
                           Height="30"
                           Stretch="Uniform"
                           Visibility="{x:Bind HasIconSource, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <FontIcon Glyph="&#xE7BA;"
                              FontSize="16"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="0,-6,0,0"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              ToolTipService.ToolTip="{x:Bind svc:Strings.BrokenBadgeTooltip}"
                              Visibility="{x:Bind IsBroken, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Button Grid.Column="1"
                        Padding="4"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ToggleFavoriteCommand}"
                        ToolTipService.ToolTip="Favorilere ekle / çıkar">
                    <Grid>
                        <FontIcon Glyph="&#xE734;"
                                  FontSize="16"
                                  Opacity="0.6"
                                  Visibility="{x:Bind IsFavorite, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <FontIcon Glyph="&#xE735;"
                                  FontSize="16"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  Visibility="{x:Bind IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Spacing="2">
                    <TextBlock Text="{x:Bind Title}"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind TypeDisplay}"
                               Opacity="0.7"
                               FontSize="12" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="5"
                                Visibility="{x:Bind HasCollection, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,0,0"
                                 VerticalAlignment="Center"
                                 Fill="{x:Bind CollectionColor, Converter={StaticResource HexToBrush}}" />
                        <TextBlock Text="{x:Bind CollectionName}"
                                   Opacity="0.8"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FilterTemplate" x:DataType="vm:SidebarFilterItemViewModel">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CollectionTemplate" x:DataType="mdl:Collection">
            <Grid ColumnSpacing="10"
                  AllowDrop="True"
                  DragOver="CollectionItem_DragOver"
                  Drop="CollectionItem_Drop"
                  Tag="{x:Bind Id}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="10"
                         Height="10"
                         Margin="0,0,0,0"
                         VerticalAlignment="Center"
                         Fill="{x:Bind Color, Converter={StaticResource HexToBrush}, FallbackValue=Transparent}" />
                <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="16" />
                <TextBlock Grid.Column="2"
                           Text="{x:Bind Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RecentPinTemplate" x:DataType="vm:PinItemViewModel">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Title}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewPinAccelerator_Invoked" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="ExportAccelerator_Invoked" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="ImportAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RefreshAccelerator_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="EditAccelerator_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid"
          RequestedTheme="{x:Bind ViewModel.RequestedTheme, Mode=OneWay}"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,10,16,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="PinQuick" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="by KTYSoft" FontSize="11" Opacity="0.6" />
            </StackPanel>

            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     Width="360"
                     Margin="16,0,0,0"
                     VerticalAlignment="Center"
                     PlaceholderText="{x:Bind svc:Strings.SearchPlaceholder}"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                     GotFocus="SearchBox_GotFocus">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" Invoked="ClearSearch_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>

            <Button x:Name="NewPinButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewPinButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="{x:Bind svc:Strings.HeadNewPin}" />
                </StackPanel>
            </Button>

            <Button x:Name="CardSizeButton"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind svc:Strings.CardSizeLabel}">
                <Button.Flyout>
                    <Flyout Opened="CardSizeFlyout_Opened">
                        <StackPanel Spacing="6" MinWidth="140">
                            <RadioButton x:Name="CardSizeSmallRadio"
                                         GroupName="CardSize"
                                         Tag="Small"
                                         Checked="CardSizeRadio_Checked">
                                <TextBlock Text="{x:Bind svc:Strings.CardSizeSmall}" />
                            </RadioButton>
                            <RadioButton x:Name="CardSizeMediumRadio"
                                         GroupName="CardSize"
                                         Tag="Medium"
                                         Checked="CardSizeRadio_Checked">
                                <TextBlock Text="{x:Bind svc:Strings.CardSizeMedium}" />
                            </RadioButton>
                            <RadioButton x:Name="CardSizeLargeRadio"
                                         GroupName="CardSize"
                                         Tag="Large"
                                         Checked="CardSizeRadio_Checked">
                                <TextBlock Text="{x:Bind svc:Strings.CardSizeLarge}" />
                            </RadioButton>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE8C7;" FontSize="14" />
            </Button>

            <Button x:Name="SettingsButton"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind svc:Strings.HeadSettingsTooltip}"
                    Click="SettingsButton_Click">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <Button x:Name="MenuButton"
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind svc:Strings.HeadMenuTooltip}">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind svc:Strings.MenuExport}" Click="ExportMenuItem_Click" />
                        <MenuFlyoutItem Text="{x:Bind svc:Strings.MenuImport}" Click="ImportMenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{x:Bind svc:Strings.MenuBackup}" Click="BackupMenuItem_Click" />
                        <MenuFlyoutItem Text="{x:Bind svc:Strings.MenuRestore}" Click="RestoreMenuItem_Click" />
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE8E8;" FontSize="14" />
            </Button>

            <Button x:Name="ThemeToggleButton"
                    Grid.Column="7"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind svc:Strings.ThemeToggleTooltip}"
                    Click="ThemeToggleButton_Click">
                <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE771;" FontSize="14" />
            </Button>

            <Button Grid.Column="8"
                    x:Name="RefreshButton"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind svc:Strings.HeadRefreshTooltip}"
                    Click="RefreshButton_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="CollectionsRow" Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind svc:Strings.SideCategories}"
                           Margin="16,12,16,4"
                           Opacity="0.6"
                           FontSize="12" />

                <ListView x:Name="FiltersList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Filters}"
                          SelectedItem="{x:Bind ViewModel.SelectedFilterItem, Mode=TwoWay}"
                          ItemTemplate="{StaticResource FilterTemplate}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="FiltersList_ItemClick" />

                <Grid x:Name="RecentSection"
                      Grid.Row="2"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind svc:Strings.SideRecent}"
                               Margin="16,12,16,4"
                               Opacity="0.6"
                               FontSize="12" />
                    <ListView x:Name="RecentPinsList"
                              Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.RecentPins}"
                              SelectionMode="Single"
                              SelectedItem="{x:Bind ViewModel.SelectedRecentPin, Mode=TwoWay}"
                              ItemTemplate="{StaticResource RecentPinTemplate}"
                              MaxHeight="168"
                              Margin="8,0,0,0" />
                </Grid>

                <Grid Grid.Row="3" Margin="16,12,16,4" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Padding="4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind svc:Strings.SideToggleCollectionsTooltip}"
                            Click="CollectionsToggleButton_Click">
                        <FontIcon x:Name="CollectionsChevron" Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind svc:Strings.SideCollections}"
                               Opacity="0.6"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Padding="6"
                            ToolTipService.ToolTip="{x:Bind svc:Strings.SideEditCollectionTooltip}"
                            Click="EditCollectionButton_Click">
                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3"
                            Padding="6"
                            ToolTipService.ToolTip="{x:Bind svc:Strings.SideNewCollectionTooltip}"
                            Click="NewCollectionButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="4"
                            Padding="6"
                            ToolTipService.ToolTip="{x:Bind svc:Strings.SideDeleteCollectionTooltip}"
                            Click="DeleteCollectionButton_Click">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView x:Name="CollectionsList"
                          Grid.Row="4"
                          ItemsSource="{x:Bind ViewModel.Collections}"
                          SelectedItem="{x:Bind ViewModel.SelectedCollection, Mode=TwoWay}"
                          ItemTemplate="{StaticResource CollectionTemplate}"
                          SelectionMode="Single"
                          Margin="0,0,0,8" />

                <Button Grid.Row="5"
                        Margin="16,12,16,12"
                        HorizontalAlignment="Stretch"
                        Click="AboutMenuItem_Click"
                        ToolTipService.ToolTip="{x:Bind svc:Strings.SideAboutTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                        <TextBlock Text="{x:Bind svc:Strings.SideAbout}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Pin grid -->
            <Grid Grid.Column="1" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusBar"
                           Grid.Row="0"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Margin="0,0,0,8"
                           Opacity="0.7"
                           IsHitTestVisible="False" />

                <GridView x:Name="PinGrid"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Pins}"
                          SelectedItem="{x:Bind ViewModel.SelectedPin, Mode=TwoWay}"
                          ItemTemplate="{StaticResource PinCardTemplate}"
                          SelectionMode="Extended"
                          IsItemClickEnabled="True"
                          CanDragItems="True"
                          CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          AllowDrop="True"
                          DragItemsStarting="PinGrid_DragItemsStarting"
                          DragItemsCompleted="PinGrid_DragItemsCompleted"
                          SelectionChanged="PinGrid_SelectionChanged"
                          ItemClick="PinGrid_ItemClick"
DoubleTapped="PinGrid_DoubleTapped"
                           ScrollViewer.IsVerticalScrollChainingEnabled="False"
                           ToolTipService.ToolTip="{x:Bind svc:Strings.GridReorderTooltip}" />

                <StackPanel x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="{x:Bind svc:Strings.EmptyNoPins}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind svc:Strings.EmptyDescription}"
                               Opacity="0.7"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360" />
                    <Button Content="{x:Bind svc:Strings.EmptyFirstPin}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NewPinButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Detail panel -->
            <Grid x:Name="DetailPanel"
                  Grid.Column="2"
                  Width="300"
                  Visibility="Collapsed"
                  Padding="16"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid Width="34" Height="34">
                                <FontIcon x:Name="DetailIcon" FontSize="26" />
                                <Image x:Name="DetailIconThumb"
                                       Width="32"
                                       Height="32"
                                       Stretch="Uniform"
                                       Visibility="Collapsed" />
                            </Grid>
                            <StackPanel>
                                <TextBlock x:Name="DetailTypeDisplay" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
</StackPanel>

                <!-- Çoklu seçim araç çubuğu -->
                <Border x:Name="SelectionBar"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,4,0,0"
                        Visibility="Collapsed"
                        Canvas.ZIndex="100"
                        Padding="12,6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="SelectionCountText"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <Button x:Name="SelectionAddButton"
                                Content="{x:Bind svc:Strings.SelBarAddToCollection}"
                                Click="SelectionAddButton_Click" />
                        <Button x:Name="SelectionDeleteButton"
                                Content="{x:Bind svc:Strings.DetailDelete}"
                                Click="SelectionDeleteButton_Click" />
                        <Button x:Name="SelectionClearButton"
                                Content="{x:Bind svc:Strings.SelBarClear}"
                                Click="SelectionClearButton_Click" />
                    </StackPanel>
                </Border>
                        </StackPanel>

                        <TextBlock x:Name="DetailTarget"
                                   FontSize="12"
                                   Opacity="0.8"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />

                        <TextBlock x:Name="DetailDescription"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="DetailTags"
                   FontSize="12"
                   Opacity="0.7"
                   Visibility="Collapsed" />

                        <TextBlock x:Name="DetailLastUsed"
                                   FontSize="12"
                                   Opacity="0.7"
                                   Visibility="Collapsed" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DetailOpenButton" Grid.Column="0" Content="{x:Bind svc:Strings.DetailOpen}" Click="LaunchButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="DetailFavoriteButton" Grid.Column="1" Content="{x:Bind svc:Strings.DetailFavorite}" Click="FavoriteButton_Click" />
                        </Grid>

                        <Button x:Name="DetailRunAsAdminButton" Content="{x:Bind svc:Strings.DetailRunAsAdmin}" Click="LaunchAdminButton_Click" />
                        <Button x:Name="DetailOpenLocationButton" Content="{x:Bind svc:Strings.DetailOpenLocation}" Click="OpenLocationButton_Click" />
                        <Button x:Name="DetailEditButton" Content="{x:Bind svc:Strings.DetailEdit}" Click="EditButton_Click" />
                        <Button x:Name="DetailDeleteButton" Content="{x:Bind svc:Strings.DetailDelete}" Click="DeleteButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Onboarding turu: karartılmış overlay + hedef vurgu + bilgi kartı -->
        <Grid x:Name="TourOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Canvas.ZIndex="1000"
              Background="#66000000"
              SizeChanged="TourOverlay_SizeChanged">
            <Border x:Name="TourHighlight"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderBrush="White"
                    BorderThickness="2"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsHitTestVisible="False" />

            <Border x:Name="TourCard"
                    Width="460"
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="24,0,24,48"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TourStepNumber"
                                   FontSize="12"
                                   Opacity="0.6"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TourStepTitle"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="TourStepSubtitle"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="12">
                        <Button x:Name="TourNextButton"
                                Content="{x:Bind svc:Strings.TourNext}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="TourNextButton_Click" />
                        <Button x:Name="TourSkipButton"
                                Content="{x:Bind svc:Strings.TourSkip}"
                                Click="TourSkipButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>