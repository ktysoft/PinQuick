<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PinQuick.App.Dialogs.CollectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:PinQuick.App.Services"
    Title="{x:Bind svc:Strings.NewCollectionDialogTitle}"
    PrimaryButtonText="{x:Bind svc:Strings.CreateButton}"
    SecondaryButtonText="{x:Bind svc:Strings.CancelButton}"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Width="360" Spacing="12">
        <TextBlock x:Name="ErrorText"
                   Text=""
                   Foreground="Red"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" />
        <TextBox x:Name="NameBox"
                 Header="{x:Bind svc:Strings.FieldCollectionName}"
                 PlaceholderText="{x:Bind svc:Strings.CollectionNamePlaceholder}" />
    </StackPanel>
</ContentDialog>