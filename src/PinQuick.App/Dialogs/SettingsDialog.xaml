<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PinQuick.App.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:PinQuick.App.Services"
    Title="{x:Bind svc:Strings.SettingsDialogTitle}"
    PrimaryButtonText="{x:Bind svc:Strings.SaveButton}"
    SecondaryButtonText="{x:Bind svc:Strings.CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    MinWidth="380"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="560"
                  Padding="0,0,8,4">
        <StackPanel Spacing="16" MinWidth="320" Margin="0,0,4,0">
        <TextBlock Text="{x:Bind svc:Strings.ThemeLabel}" FontWeight="SemiBold" />
        <ComboBox x:Name="ThemeCombo"
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="{x:Bind svc:Strings.ThemeDark}" />
            <ComboBoxItem Content="{x:Bind svc:Strings.ThemeLight}" />
        </ComboBox>

        <TextBlock Text="{x:Bind svc:Strings.LanguageLabel}" FontWeight="SemiBold" />
        <ComboBox x:Name="LanguageCombo"
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="{x:Bind svc:Strings.LanguageTurkish}" />
            <ComboBoxItem Content="{x:Bind svc:Strings.LanguageEnglish}" />
        </ComboBox>

        <ToggleSwitch x:Name="StartupToggle"
                      Header="{x:Bind svc:Strings.StartupLabel}"
                      HorizontalAlignment="Left" />

        <ToggleSwitch x:Name="MinimizeToTrayToggle"
                      Header="{x:Bind svc:Strings.MinimizeToTrayLabel}"
                      HorizontalAlignment="Left" />

        <ToggleSwitch x:Name="GlobalHotkeyToggle"
                      Header="{x:Bind svc:Strings.GlobalHotkeyLabel}"
                      HorizontalAlignment="Left"
                      Toggled="GlobalHotkeyToggle_Toggled" />

        <StackPanel x:Name="HotkeyEditor"
                    Spacing="8">
            <TextBlock Text="{x:Bind svc:Strings.HotkeyModifiersLabel}"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="ModControlButton"
                              Content="{x:Bind svc:Strings.HotkeyModifierCtrl}"
                              Tag="2"
                              MinWidth="64"
                              Checked="ModifierToggle_Checked"
                              Unchecked="ModifierToggle_Unchecked" />
                <ToggleButton x:Name="ModShiftButton"
                              Content="{x:Bind svc:Strings.HotkeyModifierShift}"
                              Tag="4"
                              MinWidth="64"
                              Checked="ModifierToggle_Checked"
                              Unchecked="ModifierToggle_Unchecked" />
                <ToggleButton x:Name="ModAltButton"
                              Content="{x:Bind svc:Strings.HotkeyModifierAlt}"
                              Tag="1"
                              MinWidth="64"
                              Checked="ModifierToggle_Checked"
                              Unchecked="ModifierToggle_Unchecked" />
            </StackPanel>

            <TextBlock Text="{x:Bind svc:Strings.HotkeyKeyLabel}"
                       FontWeight="SemiBold" />
            <TextBox x:Name="HotkeyInput"
                     IsReadOnly="True"
                     KeyDown="HotkeyInput_KeyDown"
                     PlaceholderText="{x:Bind svc:Strings.HotkeyInputPlaceholder}"
                     HorizontalAlignment="Stretch"
                     FontWeight="SemiBold" />

            <TextBlock x:Name="HotkeyHint"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <TextBlock Text="{x:Bind svc:Strings.AutoBackupLabel}" FontWeight="SemiBold" />
        <ComboBox x:Name="AutoBackupCombo"
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="{x:Bind svc:Strings.AutoBackupNone}" />
            <ComboBoxItem Content="{x:Bind svc:Strings.AutoBackupDaily}" />
            <ComboBoxItem Content="{x:Bind svc:Strings.AutoBackupWeekly}" />
        </ComboBox>

        <Button Content="{x:Bind svc:Strings.MenuShowTour}"
                HorizontalAlignment="Left"
                Click="ShowTourButton_Click" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>