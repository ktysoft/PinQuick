<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PinAnything_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:PinAnything_App.Converters"
    xmlns:mdl="using:PinAnything.Core.Models"
    xmlns:vm="using:PinAnything_App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="PinCardTemplate" x:DataType="vm:PinItemViewModel">
            <Grid Width="200" Height="150"
                  Padding="14"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="{x:Bind IconGlyph}"
                          FontSize="28"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <FontIcon Grid.Column="1"
                          Glyph="&#xE735;"
                          FontSize="16"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          Visibility="{x:Bind IsFavorite, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Spacing="2">
                    <TextBlock Text="{x:Bind Title}"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind TypeDisplay}"
                               Opacity="0.7"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FilterTemplate" x:DataType="vm:SidebarFilterItemViewModel">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CollectionTemplate" x:DataType="mdl:Collection">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewPinAccelerator_Invoked" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="ExportAccelerator_Invoked" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="ImportAccelerator_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="EditAccelerator_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid"
          RequestedTheme="{x:Bind ViewModel.RequestedTheme, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,10,16,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Pin Anything" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="by KTYSoft" FontSize="11" Opacity="0.6" />
            </StackPanel>

            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     Width="360"
                     Margin="16,0,0,0"
                     VerticalAlignment="Center"
                     PlaceholderText="Ne yapmak istiyorsun?  (Ctrl + K)"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" Invoked="ClearSearch_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>

            <ComboBox x:Name="ThemeCombo"
                      Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      MinWidth="110"
                      SelectedIndex="0"
                      SelectionChanged="ThemeCombo_SelectionChanged">
                <ComboBoxItem Content="Sistem" />
                <ComboBoxItem Content="Koyu" />
                <ComboBoxItem Content="Açık" />
            </ComboBox>

            <Button Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewPinButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Yeni Pin" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Dışa / içe aktarma">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Pins dışa aktar (JSON)" Click="ExportMenuItem_Click" />
                        <MenuFlyoutItem Text="Pins içe aktar (JSON)" Click="ImportMenuItem_Click" />
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE8E8;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Kategoriler"
                           Margin="16,12,16,4"
                           Opacity="0.6"
                           FontSize="12" />

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Filters}"
                          SelectedItem="{x:Bind ViewModel.SelectedFilterItem, Mode=TwoWay}"
                          ItemTemplate="{StaticResource FilterTemplate}"
                          SelectionMode="Single"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                <Grid Grid.Row="2" Margin="16,12,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Koleksiyonlar"
                               Opacity="0.6"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Padding="6"
                            ToolTipService.ToolTip="Yeni koleksiyon"
                            Click="NewCollectionButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2"
                            Padding="6"
                            ToolTipService.ToolTip="Seçili koleksiyonu sil"
                            Click="DeleteCollectionButton_Click">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView Grid.Row="3"
                          ItemsSource="{x:Bind ViewModel.Collections}"
                          SelectedItem="{x:Bind ViewModel.SelectedCollection, Mode=TwoWay}"
                          ItemTemplate="{StaticResource CollectionTemplate}"
                          SelectionMode="Single"
                          Margin="0,0,0,8" />
            </Grid>

            <!-- Pin grid -->
            <Grid Grid.Column="1" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusBar"
                           Grid.Row="0"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Margin="0,0,0,8"
                           Opacity="0.7"
                           IsHitTestVisible="False" />

                <GridView x:Name="PinGrid"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Pins}"
                          SelectedItem="{x:Bind ViewModel.SelectedPin, Mode=TwoWay}"
                          ItemTemplate="{StaticResource PinCardTemplate}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="PinGrid_ItemClick"
                          ScrollViewer.IsVerticalScrollChainingEnabled="False" />

                <StackPanel x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="Henüz pin yok."
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sık kullandığın uygulama, klasör, dosya veya web sitesini buraya ekle."
                               Opacity="0.7"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360" />
                    <Button Content="İlk Pini Oluştur"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NewPinButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Detail panel -->
            <Grid x:Name="DetailPanel"
                  Grid.Column="2"
                  Width="300"
                  Visibility="Collapsed"
                  Padding="16"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="DetailIcon" FontSize="26" />
                            <StackPanel>
                                <TextBlock x:Name="DetailTypeDisplay" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="DetailTarget"
                                   FontSize="12"
                                   Opacity="0.8"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />

                        <TextBlock x:Name="DetailDescription"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="DetailTags"
                                   FontSize="12"
                                   Opacity="0.7"
                                   Visibility="Collapsed" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Aç" Click="LaunchButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Grid.Column="1" Content="Favori" Click="FavoriteButton_Click" />
                        </Grid>

                        <Button Content="Yönetici olarak aç" Click="LaunchAdminButton_Click" />
                        <Button Content="Konumunu aç" Click="OpenLocationButton_Click" />
                        <Button Content="Düzenle" Click="EditButton_Click" />
                        <Button Content="Sil" Click="DeleteButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>