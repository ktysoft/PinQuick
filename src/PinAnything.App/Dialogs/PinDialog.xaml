<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PinAnything_App.Dialogs.PinDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PinAnything.Core.Models"
    xmlns:vm="using:PinAnything_App.ViewModels"
    Title="Yeni Pin"
    PrimaryButtonText="Kaydet"
    SecondaryButtonText="İptal"
    DefaultButton="Primary"
    MinWidth="460"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <Grid Width="420" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="0"
                       Text=""
                       Foreground="Red"
                       Visibility="Collapsed"
                       TextWrapping="Wrap" />

            <TextBox x:Name="TitleBox"
                     Grid.Row="1"
                     Header="Başlık"
                     PlaceholderText="Visual Studio Code" />

            <ComboBox x:Name="TypeCombo"
                      Grid.Row="2"
                      Header="Tür"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="TypeCombo_SelectionChanged" />

            <TextBox x:Name="TargetBox"
                     Grid.Row="3"
                     Header="Hedef"
                     PlaceholderText="Uygulama, klasör, dosya, URL veya komut"
                     AcceptsReturn="False" />

            <TextBox x:Name="ArgumentsBox"
                     Grid.Row="4"
                     Header="Parametreler"
                     PlaceholderText="İsteğe bağlı komut satırı parametreleri" />

            <TextBox x:Name="WorkingDirectoryBox"
                     Grid.Row="5"
                     Header="Çalışma dizini"
                     PlaceholderText="İsteğe bağlı" />

            <TextBox x:Name="DescriptionBox"
                     Grid.Row="6"
                     Header="Açıklama"
                     PlaceholderText="İsteğe bağlı"
                     AcceptsReturn="True"
                     MinHeight="64"
                     TextWrapping="Wrap" />

            <TextBox x:Name="TagsBox"
                     Grid.Row="7"
                     Header="Etiketler"
                     PlaceholderText="virgülle ayrılmış, ör: kod, sunucu" />

            <ComboBox x:Name="CollectionCombo"
                      Grid.Row="8"
                      Header="Koleksiyon"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Koleksiyonsuz" />

            <CheckBox x:Name="FavoriteCheck"
                      Grid.Row="9"
                      Content="Favori" />

            <CheckBox x:Name="AdminCheck"
                      Grid.Row="10"
                      Content="Yönetici olarak çalıştır" />
        </Grid>
    </ScrollViewer>
</ContentDialog>